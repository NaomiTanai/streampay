RPC_URL=https://soroban-testnet.stellar.org
CONTRACT_ID=C...
POLL_INTERVAL_MS=5000
PORT=8787
DATABASE_PATH=./data/streampay.sqlite
# Set this to a ledger before the contract's first event for a full backfill.
# If omitted, the indexer starts at the RPC's latest ledger.
START_LEDGER=
# Transactional outbox dispatcher (see docs/OUTBOX.md)
OUTBOX_TICK_MS=1000
OUTBOX_BATCH_SIZE=200
OUTBOX_CLAIM_TIMEOUT_MS=60000
# OUTBOX_MAX_DEPTH=          # global backpressure threshold (off when unset)
OUTBOX_ALARM_WINDOW=8
OUTBOX_ALARM_MIN_DEPTH=1000
# Light-client checkpoint proofs (GET /streams/:id/proof, see docs/SECURITY_LIGHT_CLIENT.md).
# Without a signer key the route answers 503; a real deploy must set it so clients
# can pin the verifier key that /health reports.
# CHECKPOINT_SIGNER_SECRET=S...
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# ── Shared webhook subscriptions (docs/WEBHOOKS.md §7) ───────────────────────
# AES-256-GCM key for signing secrets at rest: 64 hex characters, or any
# passphrase (SHA-256'd). Unset, secrets stay plaintext as they always were.
# WEBHOOK_SECRET_ENCRYPTION_KEY=
# Refuse to store a secret in the clear: creations answer 503 without a key.
# WEBHOOK_REQUIRE_ENCRYPTION=1
# Tenant credentials presented as `x-streampay-webhook-key`, as tenantId:keyId:secret.
# Only the digest of each secret is kept. Unset, the deployment is single-tenant
# and the transport is trusted instead.
# WEBHOOK_TENANT_KEYS=acme:k1:stdp_whk_...,globex:k1:stdp_whk_...
# WEBHOOK_DEFAULT_TENANT_ID=acme
# Per-tenant ceilings.
WEBHOOK_TENANT_QUOTA_SUBSCRIPTIONS=20
WEBHOOK_TENANT_QUOTA_EVENTS=24
WEBHOOK_TENANT_QUOTA_ROTATIONS=6
# How long a rotated-out secret keeps verifying, and how often expired
# overlaps are retired.
WEBHOOK_SECRET_ROTATION_OVERLAP_MS=86400000
# Delivery commitment per attempt, the fraction of the window allowed to miss
# it, and the window depth required before the breach alarm may engage.
WEBHOOK_SLA_MS=5000
WEBHOOK_SLA_BREACH_BUDGET=0.01
WEBHOOK_SLA_MIN_SAMPLES=20
