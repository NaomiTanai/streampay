# Horizon Configuration (classic-bridge effects source)
HORIZON_URL=https://horizon-testnet.stellar.org
HORIZON_API_TOKEN=

# Soroban RPC Configuration (contract state source)
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org/rpc
SOROBAN_RPC_TOKEN=

# Webhook target (indexer dashboard - Issue #2)
WEBHOOK_URL=http://localhost:8080/webhooks/reconciler

# Consistency & polling
CONSISTENCY_WINDOW_MS=30000
POLL_INTERVAL_MS=5000

# Logging
LOG_LEVEL=INFO
SERVICE_NAME=streampay-reconciler
ENVIRONMENT=testnet
RECONCILER_ID=primary-001

# Contract whose state is audited, and the streams to watch
CONTRACT_ID=
STREAM_IDS=

# Continuous merkleized state audit
# Where report/bundle/artifact/checkpoint publications are written
AUDIT_DIR=audit-out
# Minimum spacing between audit cycles
AUDIT_INTERVAL_MS=60000
# Publish the full record set as a verifiable artifact up to this many records
AUDIT_ARTIFACT_LIMIT=2000
# Amount tolerance grid: 1 tolerates nothing, 10 treats sub-10-unit accrual as rounding
AUDIT_TOLERANCE_EPSILON=1
# How long a key must hold one state before a transition pages anyone
AUDIT_FLAP_WINDOW_MS=120000